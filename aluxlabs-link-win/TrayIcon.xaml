<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:AluxLabs.Link.Win"
  xmlns:tb="using:H.NotifyIcon">

  <tb:TaskbarIcon x:Key="AluxLabsLinkTaskbarIcon"
                  Visibility="Visible"
                  ToolTipText="AluxLabs Link"
                  ContextMenuMode="PopupMenu"
                  IconSource="aluxlabs-link-tray.ico"
                  tb:TaskbarIcon.ContextFlyout="{StaticResource ContextFlyout}"
  />

  <MenuFlyout x:Key="ContextFlyout">
    <MenuFlyoutItem Command="{StaticResource CopyVersionCommand}" />
    <MenuFlyoutSeparator />
    <MenuFlyoutItem Command="{StaticResource ExitCommand}" />
  </MenuFlyout>

  <XamlUICommand
    x:Key="CopyVersionCommand"
    Label="AluxLabs Link 1.0.0.0"
    Description="Copy version to clipboard"
    >
    <XamlUICommand.IconSource>
      <SymbolIconSource Symbol="Copy" />
    </XamlUICommand.IconSource>
  </XamlUICommand>
  <XamlUICommand
    x:Key="ExitCommand"
    Label="Exit"
    Description="Exit"
    >
    <XamlUICommand.IconSource>
      <SymbolIconSource Symbol="Cancel" />
    </XamlUICommand.IconSource>
  </XamlUICommand>
</ResourceDictionary>
