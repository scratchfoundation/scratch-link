<?xml version="1.0" encoding="UTF-8"?>
<!--
This file sets up version properties in our own Scratch way.
-->
<Project>
	<!--
	Fallback GitVersion target for build environments where the GitInfo NuGet package targets
	are not imported (e.g. VS 2026 MSBuild resolves NuGetPackageRoot differently than the CLI).
	GitInfo's own GitVersion target is imported later via nuget.g.targets and will override this
	definition when available ("last definition wins" in MSBuild).
	-->
	<Target Name="GitVersion">
		<!-- GitInfo가 .wapproj 컨텍스트에선 로드되지 않아 빌드 번호가 0으로 떨어지는 것을 방지 -->
		<Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_AluxGitCommits" />
		</Exec>
		<Exec Command="git rev-parse --short=7 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_AluxGitCommit" />
		</Exec>
		<PropertyGroup>
			<GitSemVerMajor     Condition="'$(GitSemVerMajor)'     == ''">0</GitSemVerMajor>
			<GitSemVerMinor     Condition="'$(GitSemVerMinor)'     == ''">0</GitSemVerMinor>
			<GitSemVerPatch     Condition="'$(GitSemVerPatch)'     == ''">0</GitSemVerPatch>
			<GitSemVerDashLabel Condition="'$(GitSemVerDashLabel)' == ''"></GitSemVerDashLabel>
			<GitCommit          Condition="'$(GitCommit)'          == ''">0000000</GitCommit>
			<GitCommits         Condition="'$(GitCommits)'         == ''">0</GitCommits>
			<GitCommitDate      Condition="'$(GitCommitDate)'      == ''">$([System.DateTime]::UtcNow.ToString("o"))</GitCommitDate>
			<GitCommits Condition="('$(GitCommits)' == '' OR '$(GitCommits)' == '0') AND '$(_AluxGitCommits)' != ''">$(_AluxGitCommits.Trim())</GitCommits>
			<GitCommit Condition="('$(GitCommit)' == '' OR '$(GitCommit)' == '0000000') AND '$(_AluxGitCommit)' != ''">$(_AluxGitCommit.Trim())</GitCommit>
		</PropertyGroup>
	</Target>

	<Target Name="ScratchVersion" DependsOnTargets="GitVersion">
		<!--
		<Message Text="GitInfo: GitRepositoryUrl = $(GitRepositoryUrl)" />
		<Message Text="GitInfo: GitBranch = $(GitBranch)" />
		<Message Text="GitInfo: GitCommit = $(GitCommit)" />
		<Message Text="GitInfo: GitCommitDate = $(GitCommitDate)" />
		<Message Text="GitInfo: GitCommits = $(GitCommits)" />
		<Message Text="GitInfo: GitTag = $(GitTag)" />
		<Message Text="GitInfo: GitBaseTag = $(GitBaseTag)" />
		<Message Text="GitInfo: GitBaseVersionMajor = $(GitBaseVersionMajor)" />
		<Message Text="GitInfo: GitBaseVersionMinor = $(GitBaseVersionMinor)" />
		<Message Text="GitInfo: GitBaseVersionPatch = $(GitBaseVersionPatch)" />
		<Message Text="GitInfo: GitSemVerMajor = $(GitSemVerMajor)" />
		<Message Text="GitInfo: GitSemVerMinor = $(GitSemVerMinor)" />
		<Message Text="GitInfo: GitSemVerPatch = $(GitSemVerPatch)" />
		<Message Text="GitInfo: GitSemVerLabel = $(GitSemVerLabel)" />
		<Message Text="GitInfo: GitSemVerDashLabel = $(GitSemVerDashLabel)" />
		<Message Text="GitInfo: GitSemVerSource = $(GitSemVerSource)" />
		<Message Text="GitInfo: GitIsDirty = $(GitIsDirty)" />
		-->
		<PropertyGroup>
			<!--
			Alux fork: when there's no semver git tag, GitInfo defaults to 0.0.0 and we'd ship
			as "0.0.x" — bump the floor to 1.0.0 so we ship as "AluxLabs Link 1.0.0.x".
			To cut a real release later, tag the commit (e.g. `git tag v1.1.0`) and this guard
			will yield automatically.
			-->
			<ScratchVersionTriplet Condition="'$(GitSemVerMajor)' == '0' AND '$(GitSemVerMinor)' == '0'">1.0.0</ScratchVersionTriplet>
			<ScratchVersionTriplet Condition="'$(ScratchVersionTriplet)' == ''">$(GitSemVerMajor).$(GitSemVerMinor).$(GitSemVerPatch)</ScratchVersionTriplet>
			<ScratchVersionFull>$(ScratchVersionTriplet)$(GitSemVerDashLabel)</ScratchVersionFull>
			<ScratchVersionHash>$(GitCommit)</ScratchVersionHash>
			<ScratchVersionDetail>$(ScratchVersionFull)+$(ScratchVersionHash)</ScratchVersionDetail>
			<ScratchVersionBuildNumber>$([System.Text.RegularExpressions.Regex]::Match($(GitSemVerLabel), '\d+$'))</ScratchVersionBuildNumber>
			<ScratchVersionBuildNumber Condition=" '$(ScratchVersionBuildNumber)' == '' ">$(GitCommits)</ScratchVersionBuildNumber>
			<ScratchVersionQuad>$(ScratchVersionTriplet).$(ScratchVersionBuildNumber)</ScratchVersionQuad>
			<ScratchVersionBuildTime>$([System.DateTime]::Parse($(GitCommitDate)).ToUniversalTime().ToString(y.Mdd.Hmm))</ScratchVersionBuildTime>
		</PropertyGroup>
		<Message Text="ScratchVersionTriplet = $(ScratchVersionTriplet)" />
		<Message Text="ScratchVersionFull = $(ScratchVersionFull)" />
		<Message Text="ScratchVersionHash = $(ScratchVersionHash)" />
		<Message Text="ScratchVersionDetail = $(ScratchVersionDetail)" />
		<Message Text="ScratchVersionBuildNumber = $(ScratchVersionBuildNumber)" />
		<Message Text="ScratchVersionQuad = $(ScratchVersionQuad)" />
		<Message Text="ScratchVersionBuildTime = $(ScratchVersionBuildTime)" />
	</Target>
</Project>
